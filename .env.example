# Postgres connection string. On Supabase: Project Settings → Database → Connection string →
# "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Claude API key (server-side only; never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# ANTHROPIC_MODEL=claude-haiku-5-5
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app   # used in generated share links
# BOT_API_KEY=some-long-random-string                # lets the future WhatsApp bot act for players by phone
